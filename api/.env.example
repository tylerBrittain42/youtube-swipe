# Copy to api/.env and fill in. See docs/implementation-plan.md §3.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/callback
# The playlist to triage. Use GET /api/playlists (once authed) to find its ID,
# or copy the list= param from the playlist's YouTube URL.
YOUTUBE_PLAYLIST_ID=
# The "reject" playlist a left-swipe moves videos into (M4). Leave blank to keep
# moves local-only. Adding the write path needs a re-login (new OAuth scope).
DOWNSTREAM_PLAYLIST_ID=
PORT=8080
# Optional: daily YouTube Data API budget the move worker may spend (10k total).
# YOUTUBE_QUOTA_LIMIT=9500
# Optional: override where the SQLite file lives (default: api/data/app.sqlite).
# DATABASE_PATH=./data/app.sqlite
# Optional: how long cached playlist contents are served before a re-sync (ms).
# SYNC_TTL_MS=600000
# Optional: set to false once the OAuth consent screen is published to Production
# (Google stops expiring refresh tokens after 7 days). Silences the frontend's
# "reconnect soon" nudge. Default: true (screen still in Testing).
# CONSENT_SCREEN_TESTING=true
